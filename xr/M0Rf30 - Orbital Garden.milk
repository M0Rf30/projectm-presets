shapecode_1_g2=0
shapecode_1_b2=0
shapecode_1_a2=0
shapecode_1_border_r=1.0
shapecode_1_border_g=0.4
shapecode_1_border_b=0.6
shapecode_1_border_a=0.0
shape_1_per_frame1=
shapecode_2_enabled=0
shapecode_2_sides=4
shapecode_2_additive=0
shapecode_2_thickOutline=0
shapecode_2_textured=0
shapecode_2_x=0.5
shapecode_2_y=0.5
shapecode_2_rad=0.1
shapecode_2_ang=0.000000
shapecode_2_tex_ang=0.000000
shapecode_2_tex_zoom=1.000000
shapecode_2_r=0
shapecode_2_g=0
shapecode_2_b=0
shapecode_2_a=0
