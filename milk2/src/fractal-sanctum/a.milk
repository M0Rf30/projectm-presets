shape_3_per_frame1=
per_frame_1=dt = min(max(time-tl,0.004),0.1); tl = time;
per_frame_2=bm = bm + (bass-bm)*(1-exp(-dt/0.8)); bd = bd + (abs(bass-bm)-bd)*(1-exp(-dt/2.5));
per_frame_3=hit = min(max(((bass-bm)/max(bd,0.1) - 0.8)/1.5, 0), 1);
per_frame_4=kick = max(kick*pow(0.86, 60*dt), hit);
per_frame_5=trig = above(kick, 0.55)*above(time, tb+0.3);
per_frame_6=tb = trig*time + (1-trig)*tb;
per_frame_7=ringt = trig*0 + (1-trig)*(ringt+dt);
per_frame_8=k60 = pow(0.97, 60*dt);
per_frame_9=sb = sb*k60 + bass_att*(1-k60); sm = sm*k60 + mid_att*(1-k60); st = st*k60 + treb_att*(1-k60);
per_frame_10=th = 2.1 + 0.7*sin(time*0.043) + 0.15*sin(time*0.117+1.3);
per_frame_11=rho = 1.14 + 0.03*sin(time*0.21) + 0.025*kick;
per_frame_12=lx = rho*cos(th); ly = rho*sin(th);
per_frame_13=lx2 = lx*lx - ly*ly; ly2 = 2*lx*ly;
per_frame_14=cxx = 0.5*lx - 0.25*lx2; cyy = 0.5*ly - 0.25*ly2;
per_frame_15=re2 = lx - lx2; im2 = ly - ly2; dd2 = max(re2*re2 + im2*im2, 0.0001);
per_frame_16=a2r = -re2/dd2; a2i = im2/dd2;
per_frame_17=ar3 = lx*(lx2 - 1) - ly*ly2; ai3 = lx*ly2 + ly*(lx2 - 1);
per_frame_18=dd3 = max(ar3*ar3 + ai3*ai3, 0.0001);
per_frame_19=ir = ar3/dd3; ii = -ai3/dd3;
per_frame_20=a3r = 2*(a2r*ir - a2i*ii); a3i = 2*(a2r*ii + a2i*ir);
per_frame_21=lnl = log(rho);
per_frame_22=dtau = (0.07 + 0.03*sb + 0.22*kick)*dt/lnl;
per_frame_23=tau = tau + dtau;
per_frame_24=dpsi = (0.03 + 0.02*sin(time*0.07))*dt;
per_frame_25=psi = psi + dpsi;
per_frame_26=ph = ph + dt*(0.012 + 0.010*st);
per_frame_27=panx = 0.12*cos(time*0.09) + 0.03*sin(time*0.31); pany = 0.08*sin(time*0.09 + 0.8) + 0.03*cos(time*0.27);
per_frame_28=q1 = kick; q2 = cxx; q3 = cyy; q4 = tau - floor(tau); q5 = psi; q6 = ph;
per_frame_29=q7 = sb; q8 = st; q9 = panx; q10 = pany; q11 = dtau; q12 = dpsi;
per_frame_30=q13 = 0.5*lx; q14 = 0.5*ly; q15 = lnl; q16 = th; q17 = -a2r; q18 = -a2i; q19 = sm;
per_frame_31=q24 = a3r; q25 = a3i;
per_frame_32=pbx = -(cos(psi)*panx + sin(psi)*pany); pby = sin(psi)*panx - cos(psi)*pany;
per_frame_33=q20 = 0.5 + pbx*aspectx; q21 = 0.5 - pby;
per_frame_34=q22 = ringt*0.5; q23 = exp(-ringt*3.2);
per_frame_35=monitor = kick;
warp_1=`float2 cmul(float2 a, float2 b) { return float2(a.x*b.x - a.y*b.y, a.x*b.y + a.y*b.x); }
warp_2=`float2 rot2(float2 p, float a) { float c = cos(a); float s = sin(a); return float2(c*p.x - s*p.y, s*p.x + c*p.y); }
warp_3=`float3 hue(float h, float s)
warp_4=`{
warp_5=`  float3 k = abs(frac(h + float3(0.0, 0.66667, 0.33333))*6.0 - 3.0) - 1.0;
warp_6=`  return (1.0 - s) + s*saturate(k);
warp_7=`}
warp_8=`float2 jview(float2 p)
warp_9=`{
warp_10=`  float2 s = rot2(p, q5) + float2(q9, q10);
warp_11=`  float e = exp(-q4*q15);
warp_12=`  float a = -q4*q16;
warp_13=`  float2 w = 0.9*cmul(s, float2(e*cos(a), e*sin(a)));
warp_14=`  float2 w2 = cmul(w, w);
warp_15=`  return float2(q13, q14) + w - cmul(float2(q17, q18), w2) + cmul(float2(q24, q25), cmul(w2, w));
warp_16=`}
warp_17=`shader_body
warp_18=`{
warp_19=`  float ar = texsize.x*texsize.w;
warp_20=`  float2 p = (uv - 0.5)*float2(ar, 1.0);
warp_21=`  float t = time;
warp_22=`  float2 o = float2(q9, q10);
warp_23=`  float2 s = rot2(p, q5) + o;
warp_24=`  float e = exp(-q11*q15);
warp_25=`  float a = -q11*q16;
warp_26=`  s = cmul(s, float2(e*cos(a), e*sin(a)));
warp_27=`  float2 pp = rot2(s - o, -(q5 - q12));
warp_28=`  float2 suv = pp/float2(ar, 1.0) + 0.5;
warp_29=`  float2 nz = tex2D(sampler_noise_hq, p*0.07 + float2(t*0.003, -t*0.002)).xy - 0.5;
warp_30=`  suv += nz*0.004;
warp_31=`  float3 prev = tex2D(sampler_main, suv).rgb;
warp_32=`  prev = lerp(prev, GetBlur1(suv), 0.25);
warp_33=`  float2 c = float2(q2, q3);
warp_34=`  float2 z = jview(p);
warp_35=`  float2 t1 = 0.5*float2(cos(t*0.17), sin(t*0.13)) + float2(-0.1, 0.1);
warp_36=`  float an = t*0.11 + q6*6.2832;
warp_37=`  float2 nl = float2(cos(an), sin(an));
warp_38=`  float m1 = 9.0;
warp_39=`  float m2 = 9.0;
warp_40=`  float n = 0.0;
warp_41=`  for (int i = 0; i < 14; i++)
warp_42=`  {
warp_43=`    z = float2(z.x*z.x - z.y*z.y, 2.0*z.x*z.y) + c;
warp_44=`    float d2 = dot(z, z);
warp_45=`    float2 dz = z - t1;
warp_46=`    m1 = min(m1, dot(dz, dz));
warp_47=`    m2 = min(m2, abs(dot(z, nl) - 0.12));
warp_48=`    n += step(d2, 100.0);
warp_49=`  }
warp_50=`  float rim = smoothstep(5.0, 11.0, n)*(1.0 - smoothstep(12.0, 14.0, n));
warp_51=`  float3 em = hue(0.06 + 0.04*sqrt(m1), 0.85)*exp(-m2*28.0)*(1.0 - 0.7*step(13.5, n));
warp_52=`  em += float3(1.0, 0.78, 0.45)*rim*0.5;
warp_53=`  ret = prev*0.92 + em*0.012*(1.0 + 1.5*q1);
warp_54=`  ret = max(ret - 0.002, 0.0);
warp_55=`}
comp_1=`float2 cmul(float2 a, float2 b) { return float2(a.x*b.x - a.y*b.y, a.x*b.y + a.y*b.x); }
comp_2=`float2 rot2(float2 p, float a) { float c = cos(a); float s = sin(a); return float2(c*p.x - s*p.y, s*p.x + c*p.y); }
comp_3=`float3 hue(float h, float s)
comp_4=`{
comp_5=`  float3 k = abs(frac(h + float3(0.0, 0.66667, 0.33333))*6.0 - 3.0) - 1.0;
comp_6=`  return (1.0 - s) + s*saturate(k);
comp_7=`}
comp_8=`float2 jview(float2 p)
comp_9=`{
comp_10=`  float2 s = rot2(p, q5) + float2(q9, q10);
comp_11=`  float e = exp(-q4*q15);
comp_12=`  float a = -q4*q16;
comp_13=`  float2 w = 0.9*cmul(s, float2(e*cos(a), e*sin(a)));
comp_14=`  float2 w2 = cmul(w, w);
comp_15=`  return float2(q13, q14) + w - cmul(float2(q17, q18), w2) + cmul(float2(q24, q25), cmul(w2, w));
comp_16=`}
comp_17=`shader_body
comp_18=`{
comp_19=`  float ar = texsize.x*texsize.w;
comp_20=`  float2 p = (uv - 0.5)*float2(ar, 1.0);
comp_21=`  float r = length(p);
comp_22=`  float t = time;
comp_23=`  float2 c = float2(q2, q3);
comp_24=`  float2 z = jview(p);
comp_25=`  float2 t1 = 0.5*float2(cos(t*0.17), sin(t*0.13)) + float2(-0.1, 0.1);
comp_26=`  float an = t*0.11 + q6*6.2832;
comp_27=`  float2 nl = float2(cos(an), sin(an));
comp_28=`  float m1 = 9.0;
comp_29=`  float m2 = 9.0;
comp_30=`  float m3 = 9.0;
comp_31=`  float nu = 0.0;
comp_32=`  float esc = 0.0;
comp_33=`  for (int i = 0; i < 38; i++)
comp_34=`  {
comp_35=`    z = float2(z.x*z.x - z.y*z.y, 2.0*z.x*z.y) + c;
comp_36=`    float d2 = dot(z, z);
comp_37=`    float2 dz = z - t1;
comp_38=`    m1 = min(m1, dot(dz, dz));
comp_39=`    m2 = min(m2, abs(dot(z, nl) - 0.12));
comp_40=`    m3 = min(m3, min(abs(z.x), abs(z.y)));
comp_41=`    if (d2 > 1000.0)
comp_42=`    {
comp_43=`      nu = float(i) + 1.0 - log2(0.5*log2(d2));
comp_44=`      esc = 1.0;
comp_45=`      break;
comp_46=`    }
comp_47=`  }
comp_48=`  float nc = nu - q4;
comp_49=`  float f = frac(nc);
comp_50=`  float cell = floor(nc);
comp_51=`  float fw = min(length(float2(ddx(nc), ddy(nc))), 1.0);
comp_52=`  float k1 = sqrt(m1);
comp_53=`  float hs = frac(cell*0.61803 + 0.3);
comp_54=`  float hv = frac(sin(cell*7.31 + 1.7)*9631.7);
comp_55=`  float hb = 0.015 + 0.03*sin(q6*6.2832);
comp_56=`  float jw = step(0.88, hs);
comp_57=`  float hu = hb - 0.03 + 0.1*hs*(1.0 - jw)*1.13 + 0.6*jw;
comp_58=`  float3 gold = float3(1.0, 0.76, 0.34);
comp_59=`  float edge = min(f, 1.0 - f);
comp_60=`  float lead = smoothstep(0.0, 0.06 + fw, edge);
comp_61=`  float shade = (0.05 + 1.0*pow(sin(3.14159*f), 1.3))*(0.3 + 0.8*hv);
comp_62=`  float3 pane = hue(hu, 1.0)*shade*lead;
comp_63=`  float3 ext = pane*(0.8 + 0.6*smoothstep(10.0, 30.0, nu));
comp_64=`  ext += gold*exp(-edge*edge*3000.0)*0.6*(1.0 - smoothstep(0.3, 1.0, fw));
comp_65=`  ext += hue(hb + 0.58, 1.0)*exp(-m2*30.0)*0.8;
comp_66=`  ext += gold*exp(-m3*45.0)*0.5;
comp_67=`  ext += float3(1.0, 0.85, 0.55)*smoothstep(24.0, 38.0, nu)*0.5;
comp_68=`  float aa = smoothstep(0.35, 0.9, fw);
comp_69=`  ext = lerp(ext, float3(0.28, 0.09, 0.04)*(0.4 + 0.8*smoothstep(8.0, 26.0, nu)), aa);
comp_70=`  float rb = k1*7.0;
comp_71=`  float fr = frac(rb);
comp_72=`  float hr = frac(sin(floor(rb)*17.13 + 3.7)*43758.5);
comp_73=`  float fe = min(fr, 1.0 - fr);
comp_74=`  float rsh = 0.08 + 1.0*pow(sin(3.14159*fr), 0.8);
comp_75=`  float3 inn = hue(hb + 0.1*hr + 0.55*step(0.78, hr), 1.0)*rsh*smoothstep(0.0, 0.1, fe);
comp_76=`  inn += gold*exp(-fe*fe*1200.0)*0.8;
comp_77=`  inn *= 0.12 + 0.6*smoothstep(0.0, 1.0, 1.4 - k1);
comp_78=`  inn += hue(hb + 0.58, 1.0)*exp(-m2*24.0)*0.7;
comp_79=`  float3 col = lerp(inn, ext, esc);
comp_80=`  float2 sg = rot2(p, t*0.02)*30.0;
comp_81=`  float2 sid = floor(sg);
comp_82=`  float4 sr = tex2D(sampler_pw_noise_lq, (sid + 0.5)/256.0);
comp_83=`  float2 sd = frac(sg) - 0.5 - (sr.gb - 0.5)*0.6;
comp_84=`  float spk = step(0.95, sr.r)*exp(-dot(sd, sd)*110.0)*(0.5 + 0.5*sin(t*(2.0 + 3.0*sr.a) + sr.b*40.0));
comp_85=`  col += float3(1.0, 0.85, 0.6)*spk*0.7*(0.3 + 0.7*esc);
comp_86=`  float2 ca = p/max(r, 0.001)*0.003*r;
comp_87=`  float3 tr;
comp_88=`  tr.r = tex2D(sampler_main, uv + ca).r;
comp_89=`  tr.g = tex2D(sampler_main, uv).g;
comp_90=`  tr.b = tex2D(sampler_main, uv - ca).b;
comp_91=`  float3 b2 = GetBlur2(uv);
comp_92=`  float3 b3 = GetBlur3(uv);
comp_93=`  col = col + tr*0.3 + b2*0.06 + b3*0.08;
comp_94=`  col *= 1.0 + 0.4*q1;
comp_95=`  col = 1.0 - exp(-col*1.15);
comp_96=`  col = lerp(col, col*col*(3.0 - 2.0*col), 0.6);
comp_97=`  col *= lerp(0.4, 1.0, smoothstep(1.2, 0.3, r));
comp_98=`  ret = saturate(col);
comp_99=`}
