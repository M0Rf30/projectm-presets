shape_3_per_frame1=
per_frame_1=dt = min(max(time-tl,0.004),0.1); tl = time; bm = bm + (bass-bm)*(1-exp(-dt/0.8)); bd = bd + (abs(bass-bm)-bd)*(1-exp(-dt/2.5));
per_frame_2=hit = min(max(((bass-bm)/max(bd,0.1) - 0.8)/1.5, 0), 1);
per_frame_3=kick = max(kick*pow(0.86, 60*dt), hit);
per_frame_4=tm = tm + (treb-tm)*(1-exp(-dt/0.8)); td = td + (abs(treb-tm)-td)*(1-exp(-dt/2.5));
per_frame_5=thit = min(max(((treb-tm)/max(td,0.1) - 0.8)/1.5, 0), 1);
per_frame_6=hat = max(hat*pow(0.8, 60*dt), thit);
per_frame_7=sb = sb*pow(0.97,60*dt) + bass_att*(1-pow(0.97,60*dt));
per_frame_8=sm = sm*pow(0.97,60*dt) + mid_att*(1-pow(0.97,60*dt));
per_frame_9=st = st*pow(0.97,60*dt) + treb_att*(1-pow(0.97,60*dt));
per_frame_10=ph = ph + dt*(0.55 + 0.30*sb + 1.1*kick);
per_frame_11=q1 = kick; q2 = ph; q3 = sb; q4 = sm; q5 = st; q6 = hat;
per_frame_12=q7 = ph*0.7 + 3.0*sin(time*0.05);
per_frame_13=zoom = 1 + 0.012*kick;
per_frame_14=monitor = kick;
warp_1=`float4 N(float2 x)
warp_2=`{
warp_3=`  return tex2D(sampler_noise_hq, x);
warp_4=`}
warp_5=`float2 Q(float2 p, float t)
warp_6=`{
warp_7=`  return N(p*0.12 + float2(t*0.011, -t*0.008)).xy - 0.5;
warp_8=`}
warp_9=`float H(float2 p, float t, float sw, float fine)
warp_10=`{
warp_11=`  float2 q = Q(p, t);
warp_12=`  float2 r = N((p + q*0.8)*0.11 + float2(5.2 - t*0.013, 1.3 + t*0.010)).zw - 0.5;
warp_13=`  float h = N((p + r*0.9*sw + q*0.4)*0.14 + float2(t*0.006, 0.0)).x;
warp_14=`  h += 0.35*N((p + r*0.6*sw)*0.30 + float2(-t*0.02, t*0.016)).y;
warp_15=`  h += fine*N((p + r*0.3)*1.0 + float2(t*0.05, -t*0.04)).z;
warp_16=`  return h;
warp_17=`}
warp_18=`float3 Pal(float x)
warp_19=`{
warp_20=`  float w0 = 0.5 + 0.5*cos(6.2832*x);
warp_21=`  float w1 = 0.5 + 0.5*cos(6.2832*(x - 0.25));
warp_22=`  float w2 = 0.5 + 0.5*cos(6.2832*(x - 0.50));
warp_23=`  float w3 = 0.5 + 0.5*cos(6.2832*(x - 0.75));
warp_24=`  return (float3(0.95,0.36,0.78)*w0 + float3(1.0,0.80,0.40)*w1 + float3(0.18,0.80,0.80)*w2 + float3(0.36,0.34,0.92)*w3)*0.5;
warp_25=`}
warp_26=`shader_body
warp_27=`{
warp_28=`  float ar = texsize.x*texsize.w;
warp_29=`  float2 p = (uv-0.5)*float2(ar,1);
warp_30=`  float t = q2;
warp_31=`  float sw = 1.0 + 0.25*q3 + 0.3*q1;
warp_32=`  float fine = 0.04*(0.5 + 0.8*q5 + 1.2*q6) + 0.07*get_fft(0.06) + 0.05*get_fft(0.2);
warp_33=`  float e = 0.012;
warp_34=`  float h0 = H(p, t, sw, fine);
warp_35=`  float hx = H(p + float2(e,0.0), t, sw, fine);
warp_36=`  float hy = H(p + float2(0.0,e), t, sw, fine);
warp_37=`  float2 g = float2(hx-h0, hy-h0)/e;
warp_38=`  float3 n = normalize(float3(-g*(0.035+0.015*q1), 1.0));
warp_39=`  float3 L = normalize(float3(0.6*cos(t*0.08), 0.5+0.3*sin(t*0.06), 0.7));
warp_40=`  float3 Hv = normalize(L + float3(0.0,0.0,1.0));
warp_41=`  float nh = saturate(dot(n,Hv));
warp_42=`  float diff = saturate(dot(n,L)*0.5 + 0.5);
warp_43=`  float fres = pow(1.0 - n.z, 2.0);
warp_44=`  float2 fl = Q(p, t);
warp_45=`  float P = h0*0.8 + (1.0-n.z)*1.2 + fl.x*1.4 + t*0.02 + 0.06*q1 + 0.2*get_fft(0.12);
warp_46=`  float3 film = Pal(P);
warp_47=`  float3 S = film*(0.14 + 1.0*diff*diff*diff) + pow(nh, 90.0)*float3(1.0,0.97,0.92)*(1.2 + 0.8*q1);
warp_48=`  S += pow(nh, 9.0)*0.2*film;
warp_49=`  S += fres*film.zxy*0.45;
warp_50=`  S = 1.0 - exp(-S*1.6);
warp_51=`  float2 suv = uv - fl*float2(1.0/ar, 1.0)*0.012;
warp_52=`  float3 prev = tex2D(sampler_main, suv).rgb;
warp_53=`  ret = lerp(S, prev, 0.4);
warp_54=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float ar = texsize.x*texsize.w;
comp_4=`  float2 p = (uv-0.5)*float2(ar,1);
comp_5=`  float r = length(p);
comp_6=`  float2 ca = p/max(r,0.001)*(0.0015 + 0.003*r + 0.002*q1)*float2(1.0/ar,1.0);
comp_7=`  float3 c;
comp_8=`  c.r = tex2D(sampler_main, uv + ca).r;
comp_9=`  c.g = tex2D(sampler_main, uv).g;
comp_10=`  c.b = tex2D(sampler_main, uv - ca).b;
comp_11=`  float3 b1 = GetBlur1(uv);
comp_12=`  float3 b2 = GetBlur2(uv);
comp_13=`  float3 b3 = GetBlur3(uv);
comp_14=`  float3 col = c + max(b1 - 0.5, 0.0)*0.5*(1.0 + q1) + b2*0.18 + b3*0.15;
comp_15=`  col *= 1.0 + 0.16*q1;
comp_16=`  col = col*col*(3.0 - 2.0*col)*0.6 + col*0.4;
comp_17=`  float l = dot(col, float3(0.3,0.59,0.11));
comp_18=`  col = lerp(float3(l,l,l), col, 1.4);
comp_19=`  col *= lerp(0.65, 1.0, smoothstep(1.1, 0.25, r));
comp_20=`  float dn = tex2D(sampler_pw_noise_lq, uv*texsize.xy/256.0).r - 0.5;
comp_21=`  col += dn/160.0;
comp_22=`  ret = saturate(col);
comp_23=`}
